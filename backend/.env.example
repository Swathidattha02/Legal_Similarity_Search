# Python FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# CORS — frontend origin
CLIENT_URL=http://localhost:5173
