PORT=8000

# OpenAI
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# ChromaDB persistent storage path (relative to ai-service root)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=legal_judgments

# Embedding model
EMBEDDING_MODEL=law-ai/InLegalBERT

# Tesseract OCR — set to your Tesseract installation path on Windows
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# Express backend (for any callbacks)
EXPRESS_BACKEND_URL=http://localhost:5000

# Logging
LOG_LEVEL=info
